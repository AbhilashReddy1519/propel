  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "clean:logs": "rm -rf logs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:export": "drizzle-kit export",
    "db:generate:init": "drizzle-kit generate --name=init",
    "db:generate:custom": "drizzle-kit generate --custom --name=custom",
    "db:reset": "npm run db:generate && npm run db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
